AWID_DATABASE_URL=postgresql://awid:change-me@postgres:5432/awid
AWID_REDIS_URL=redis://redis:6379/0
AWID_HOST=0.0.0.0
AWID_PORT=8010
AWID_DB_SCHEMA=awid
AWID_RATE_LIMIT_BACKEND=redis
# Optional: generate with `openssl rand -hex 32`; use the same value on aweb.
AWID_SERVICE_TOKEN=
AWID_LOG_LEVEL=info
AWID_LOG_JSON=true
# Comma-separated public origins clients write to (e.g. https://registry.example.com).
# Controller writes sign one of them; without it every controller write gets 503.
AWID_PUBLIC_ORIGINS=http://localhost:8010
