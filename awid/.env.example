AWID_DATABASE_URL=postgresql://awid:change-me@postgres:5432/awid
AWID_REDIS_URL=redis://redis:6379/0
AWID_HOST=0.0.0.0
AWID_PORT=8010
AWID_DB_SCHEMA=awid
AWID_RATE_LIMIT_BACKEND=redis
# Optional: generate with `openssl rand -hex 32`; use the same value on aweb.
AWID_SERVICE_TOKEN=
# Canonical public origin; required for registry import and risk-override capabilities.
AWID_PUBLIC_ORIGIN=https://api.awid.ai
# Enable only after assertion-capable parent writers are deployed and backfill is verified.
AWID_REQUIRE_DELEGATION_ASSERTION=0
AWID_LOG_LEVEL=info
AWID_LOG_JSON=true
