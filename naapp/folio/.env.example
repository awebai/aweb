# PostgreSQL database used by folio
FOLIO_DATABASE_URL=postgresql://localhost/folio

# AWID registry used to resolve team public keys and certificate revocations
FOLIO_AWID_REGISTRY_URL=https://api.awid.ai

# Public origin clients sign in the v2 team-auth audience (aud)
FOLIO_PUBLIC_ORIGIN=http://127.0.0.1:8765

# PgBouncer/Neon-safe pool defaults
FOLIO_DB_POOL_MIN_CONNECTIONS=1
FOLIO_DB_POOL_MAX_CONNECTIONS=5
FOLIO_DB_STATEMENT_CACHE_SIZE=0

# Cache public AWID team facts for 10 minutes
FOLIO_AUTH_CACHE_TTL_SECONDS=600

# Reject signed requests more than 5 minutes from server time
FOLIO_TIMESTAMP_SKEW_SECONDS=300

# Present-link TTL defaults
FOLIO_DEFAULT_PRESENT_TTL_SECONDS=86400
FOLIO_MAX_PRESENT_TTL_SECONDS=604800
