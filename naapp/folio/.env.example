# PostgreSQL database used by folio
FOLIO_DATABASE_URL=postgresql://localhost/folio

# AWID registry used to resolve team public keys and certificate revocations
FOLIO_AWID_REGISTRY_URL=https://api.awid.ai
# Optional service credential for reading private teams; provision as a secret
FOLIO_AWID_SERVICE_TOKEN=

# Public origin clients sign in the v2 team-auth audience (aud)
FOLIO_PUBLIC_ORIGIN=http://127.0.0.1:8765

# PgBouncer/Neon-safe pool defaults
FOLIO_DB_POOL_MIN_CONNECTIONS=1
FOLIO_DB_POOL_MAX_CONNECTIONS=5
FOLIO_DB_STATEMENT_CACHE_SIZE=0

# Cache AWID facts for at most 60 seconds (shared verifier limit: 1..60)
FOLIO_AUTH_CACHE_TTL_SECONDS=60

# Reject signed requests more than 5 minutes from server time
FOLIO_TIMESTAMP_SKEW_SECONDS=300

# Present-link TTL defaults
FOLIO_DEFAULT_PRESENT_TTL_SECONDS=86400
FOLIO_MAX_PRESENT_TTL_SECONDS=2592000

# Manifest v2 requires a separate, owner-readable app-grant-read key file.
# Keep the existing emit seed/file configuration separate.
# FOLIO_APP_KEY_FILES={"folio:emit-1":"/run/secrets/folio-emit.hex","folio:grant-read-1":"/run/secrets/folio-grant-read.hex"}
# Records use an independent deletion-ledger DATABASE, not another content schema.
# AWEB_PAGE_DELETION_DATABASE_URL=postgresql://localhost/folio_deletions
# Set AWEB_PAGE_RETENTION_POLICY explicitly; see docs/production-operations.md.
