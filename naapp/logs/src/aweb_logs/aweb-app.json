{
  "manifest_version": 2,
  "app": {
    "id": "logs",
    "version": "0.1.0",
    "origin": "https://logs.aweb.ai"
  },
  "tools": [
    {
      "name": "ingest",
      "description": "Admit one hook event delivered to this team's log: its producer's signed envelope, appended to the team's hash chain. Answers a signed receipt.",
      "method": "POST",
      "path": "/v1/hooks/ingest",
      "input_schema": {
        "type": "object",
        "properties": {
          "hook_event": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "hook_event",
          "signature"
        ],
        "additionalProperties": false
      },
      "params": [
        {
          "name": "hook_event",
          "in": "body"
        },
        {
          "name": "signature",
          "in": "body"
        }
      ],
      "scopes": [
        "logs.ingest"
      ],
      "mutation": true,
      "body": {
        "mode": "json"
      },
      "invocation_contexts": [
        "hook"
      ]
    },
    {
      "name": "reader-slot",
      "description": "Issue a pending reader slot for the contact the owner will designate.",
      "method": "POST",
      "path": "/v1/reader-slots",
      "input_schema": {
        "type": "object",
        "properties": {
          "contact_sha256": {
            "type": "string"
          }
        },
        "required": [
          "contact_sha256"
        ],
        "additionalProperties": false
      },
      "params": [
        {
          "name": "contact_sha256",
          "in": "body"
        }
      ],
      "scopes": [
        "logs.readers"
      ],
      "mutation": true,
      "body": {
        "mode": "json"
      },
      "invocation_contexts": [
        "agent"
      ]
    },
    {
      "name": "remove-reader",
      "description": "Remove a reader of the team's log; never the last one.",
      "method": "POST",
      "path": "/v1/reader-removals",
      "input_schema": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string"
          }
        },
        "required": [
          "scope"
        ],
        "additionalProperties": false
      },
      "params": [
        {
          "name": "scope",
          "in": "body"
        }
      ],
      "scopes": [
        "logs.readers"
      ],
      "mutation": true,
      "body": {
        "mode": "json"
      },
      "invocation_contexts": [
        "agent"
      ]
    }
  ],
  "app_keys": [
    {
      "kid": "logs-chain",
      "purposes": [
        "logs-receipt",
        "logs-checkpoint"
      ]
    },
    {
      "kid": "logs-resolve",
      "purposes": [
        "hook-resolve"
      ]
    },
    {
      "kid": "logs-grants",
      "purposes": [
        "app-grant-read"
      ]
    },
    {
      "kid": "logs-governance",
      "purposes": [
        "hook-event"
      ]
    }
  ],
  "hooks": {
    "registration_version": 1,
    "registrations": [
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-secret-use-hook",
        "tool": "ingest",
        "scopes": [
          "logs.ingest"
        ]
      },
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-governance-hook",
        "tool": "ingest",
        "scopes": [
          "logs.ingest"
        ]
      },
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-manifest-command-hook",
        "tool": "ingest",
        "scopes": [
          "logs.ingest"
        ]
      },
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-mutation-hook",
        "tool": "ingest",
        "scopes": [
          "logs.ingest"
        ]
      },
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-command-hook",
        "tool": "ingest",
        "scopes": [
          "logs.ingest"
        ]
      }
    ],
    "productions": [
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-governance-hook",
        "reads": []
      }
    ]
  }
}
