{
  "manifest_version": 2,
  "app": {
    "id": "logs",
    "version": "0.1.0",
    "origin": "https://logs.aweb.ai"
  },
  "tools": [
    {
      "name": "ingest",
      "description": "Admit one hook event delivered to this team's log: its producer's signed envelope, appended to the team's hash chain. Answers a signed receipt.",
      "method": "POST",
      "path": "/v1/hooks/ingest",
      "input_schema": {
        "type": "object",
        "properties": {
          "hook_event": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        },
        "required": [
          "hook_event",
          "signature"
        ],
        "additionalProperties": false
      },
      "params": [
        {
          "name": "hook_event",
          "in": "body"
        },
        {
          "name": "signature",
          "in": "body"
        }
      ],
      "scopes": [
        "logs.ingest"
      ],
      "mutation": true,
      "body": {
        "mode": "json"
      },
      "invocation_contexts": [
        "hook"
      ]
    },
    {
      "name": "verify",
      "description": "Return integrity flags only for this team's selected log epoch. Requires the current member's owner-delegated verifier assignment; returns no log content and does not prove complete delivery.",
      "method": "POST",
      "path": "/v1/integrity",
      "input_schema": {
        "type": "object",
        "properties": {
          "chain_epoch": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      },
      "params": [
        {
          "name": "chain_epoch",
          "in": "body"
        }
      ],
      "scopes": [
        "logs.verify"
      ],
      "mutation": false,
      "body": {
        "mode": "json"
      },
      "invocation_contexts": [
        "agent"
      ]
    },
    {
      "name": "reader-slot",
      "description": "Issue a pending reader slot bound to a contact commitment. The slot grants no read authority; the owner must designate it with an owner act.",
      "method": "POST",
      "path": "/v1/reader-slots",
      "input_schema": {
        "type": "object",
        "properties": {
          "contact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "contact_sha256"
        ],
        "additionalProperties": false
      },
      "params": [
        {
          "name": "contact_sha256",
          "in": "body"
        }
      ],
      "scopes": [
        "logs.readers"
      ],
      "mutation": true,
      "body": {
        "mode": "json"
      },
      "invocation_contexts": [
        "agent"
      ]
    }
  ],
  "app_keys": [
    {
      "kid": "logs-chain",
      "purposes": [
        "logs-receipt",
        "logs-checkpoint"
      ]
    },
    {
      "kid": "logs-resolve",
      "purposes": [
        "hook-resolve"
      ]
    }
  ],
  "hooks": {
    "registration_version": 1,
    "registrations": [
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-secret-use-hook",
        "tool": "ingest",
        "scopes": [
          "logs.ingest"
        ]
      },
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-governance-hook",
        "tool": "ingest",
        "scopes": [
          "logs.ingest"
        ]
      },
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-manifest-command-hook",
        "tool": "ingest",
        "scopes": [
          "logs.ingest"
        ]
      },
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-mutation-hook",
        "tool": "ingest",
        "scopes": [
          "logs.ingest"
        ]
      },
      {
        "catalog": {
          "id": "aweb.hooks",
          "version": 1
        },
        "hook": "post-command-hook",
        "tool": "ingest",
        "scopes": [
          "logs.ingest"
        ]
      }
    ],
    "productions": []
  }
}
