# PostgreSQL database used by library
LIBRARY_DATABASE_URL=postgresql://localhost/library

# AWID registry used to resolve team public keys and certificate revocations
LIBRARY_AWID_REGISTRY_URL=https://api.awid.ai

# Public origin clients sign in the v2 team-auth audience (aud)
LIBRARY_PUBLIC_ORIGIN=http://127.0.0.1:8765

# PgBouncer/Neon-safe pool defaults
LIBRARY_DB_POOL_MIN_CONNECTIONS=1
LIBRARY_DB_POOL_MAX_CONNECTIONS=5
LIBRARY_DB_STATEMENT_CACHE_SIZE=0

# Cache public AWID team facts for 10 minutes
LIBRARY_AUTH_CACHE_TTL_SECONDS=600

# Reject signed requests more than 5 minutes from server time
LIBRARY_TIMESTAMP_SKEW_SECONDS=300

# Optional non-Render build identity fallback for local image tests. Render's
# platform-provided RENDER_GIT_COMMIT is authoritative in production.
# LIBRARY_GIT_SHA=

# Self-custodial app-event emit key (optional; library emits nothing without it)
# LIBRARY_APP_EVENTS_ORIGIN=https://app.aweb.ai/api
# LIBRARY_APP_EMIT_KID=library:emit-1
# LIBRARY_APP_EMIT_KEY_SEED_HEX=
