# Enforcing profile for the disposable Secrets runner OCI proof container.
abi <abi/4.0>,
include <tunables/global>

@{proof_fixture}=/memory/tmp*
@{proof_job}=@{proof_fixture}/workspace/job-*
@{proof_bundle}=@{proof_fixture}/bundle @{proof_job}/bundle
@{proof_rootfs}=@{proof_bundle}/rootfs
@{proof_data}=@{proof_fixture}/mount-data

profile aweb-secrets-oci-proof flags=(attach_disconnected,mediate_deleted) {
  # runc creates the nested user namespace and sets up its mounts there.
  userns create,

  # Local TLS, runc's Unix sockets, and interface discovery in the no-network
  # container. There are no rules for raw IP, vsock, or kernel crypto sockets.
  network inet stream,
  network inet6 stream,
  network inet dgram,
  network inet6 dgram,
  network unix stream,
  network netlink raw,

  signal (send,receive) set=(exists,kill,term,urg) peer=aweb-secrets-oci-proof,
  ptrace (read,readby) peer=aweb-secrets-oci-proof,

  # The proof's executable and read-only dependency paths.
  /usr/sbin/{docker-init,runc} rix,
  /usr/bin/{umoci,python3,python3.13} rix,
  /usr/bin/busybox r,
  /bin/{busybox,env,pwd} rix,
  /venv/bin/python3 rix,
  /opt/pythons/cpython-3.12.*/bin/python3.12 rix,
  /opt/pythons/cpython-3.12.*/lib/python3.12/{,**} r,
  /opt/pythons/cpython-3.12.*/lib/python3.12/{,**/}*.so mr,
  /venv/pyvenv.cfg r,
  /venv/lib/python3.12/site-packages/{,**} r,
  /venv/lib/python3.12/site-packages/{,**/}*.so mr,
  /usr/lib/*-linux-gnu/{ld-linux*,*.so*,gconv/*.so} mr,
  /usr/lib/*-linux-gnu/gconv/gconv-modules.cache r,
  /usr/lib/locale/C.utf8/{,**} r,
  /usr/{lib,local/lib}/python3*/{,**} r,
  /usr/lib/python3.13/lib-dynload/*.so mr,
  /usr/share/zoneinfo/Etc/UTC r,
  /usr/share/terminfo/d/dumb r,
  /etc/{group,passwd,ld.so.cache,hosts,nsswitch.conf,gai.conf,host.conf,resolv.conf} r,
  /etc/ssl/openssl.cnf r,
  /source/naapp/secrets/{runner,values}/{,**} r,
  /source/naapp-lib/src/{,**} r,
  /runner/{,**} r,

  # Writable test data stays in owner-only fixtures. The explicit disk fixture
  # supplies the negative tmpfs check. Only four fixture helper names execute.
  /{,dev/,memory/,tmp/,disk/} r,
  /dev/null rw,
  /dev/{urandom,zero} r,
  owner @{proof_fixture}/{,**} rwk,
  owner @{proof_fixture}/{blocked-unpacker,delayed-runc,slow-unpacker,waiting-tool} ix,
  owner /tmp/{tmp*,pytest-of-unknown}/{,**} rwk,
  owner /tmp/{????????,tmp????????} rwk,
  owner /disk/tmp*/{,**} rw,
  /proc/self/exe ix,
  # runc reexecutes from its cloned memfd, audited as the disconnected /
  # and as the original numbered fd. Inherit this same profile on exec.
  owner / ix,
  owner /dev/fd/[0-9]* ix,

  # runc writes only the maps for its own nested processes. Proc observations
  # are read-only, including the runner's PID and cleanup assertions.
  owner @{PROC}/[0-9]*/{uid_map,gid_map,setgroups} rw,
  @{PROC}/[0-9]*/{,fd/,maps,stat,mountinfo,cgroup,cmdline,status,environ} r,
  @{PROC}/[0-9]*/task/[0-9]*/children r,
  @{PROC}/{filesystems,sys/kernel/cap_last_cap,sys/vm/overcommit_memory} r,
  /sys/fs/cgroup/{cgroup.controllers,cpu.max} r,
  /sys/devices/system/cpu/online r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,

  # Prepare and pivot to a rootfs below the private fixture. The old root is
  # made slave before detaching it from the nested mount namespace.
  audit mount options=(rw,make-rslave) -> /,
  mount options=(rw,make-private) -> /memory/,
  mount options=(rw,make-private) -> @{proof_fixture}/,
  mount options=(rw,make-private) -> @{proof_fixture}/workspace/,
  mount options=(rw,make-private) -> @{proof_job}/,
  mount options=(rw,make-private) -> @{proof_bundle}/,
  mount options=(rw,make-private) -> @{proof_rootfs}/,
  mount options=(rw,rbind) @{proof_rootfs}/ -> @{proof_rootfs}/,
  pivot_root oldroot=@{proof_rootfs}/ @{proof_rootfs}/,
  umount /,

  # Runtime-managed filesystems and devices in the nested root.
  mount fstype=proc -> @{proof_rootfs}/proc/,
  mount fstype=tmpfs options=(rw,nosuid,strictatime) -> @{proof_rootfs}/dev/,
  mount fstype=tmpfs options=(rw,nosuid,nodev,noexec) -> @{proof_rootfs}/dev/shm/,
  mount fstype=devpts options=(rw,nosuid,noexec) -> @{proof_rootfs}/dev/pts/,
  mount fstype=mqueue options=(rw,nosuid,nodev,noexec) -> @{proof_rootfs}/dev/mqueue/,
  mount options=(rw,bind) /dev/full -> @{proof_rootfs}/dev/full,
  mount options=(rw,bind) /dev/null -> @{proof_rootfs}/dev/null,
  mount options=(rw,bind) /dev/random -> @{proof_rootfs}/dev/random,
  mount options=(rw,bind) /dev/tty -> @{proof_rootfs}/dev/tty,
  mount options=(rw,bind) /dev/urandom -> @{proof_rootfs}/dev/urandom,
  mount options=(rw,bind) /dev/zero -> @{proof_rootfs}/dev/zero,

  # The public preparation test binds one synthetic data directory read-only.
  mount options=(rw,rbind) @{proof_data}/ -> @{proof_rootfs}@{proof_data}/,
  mount options=(rw,make-rprivate) -> @{proof_rootfs}@{proof_data}/,
  mount options=(ro,nosuid,nodev,remount,rbind) -> @{proof_rootfs}@{proof_data}/,

  # runc seals these proc entries after the pivot. Self-binds add no new
  # source path. The workload proof verifies the read-only remounts because
  # AppArmor matches each operation independently.
  mount options=(rw,rbind) /proc/bus/ -> /proc/bus/,
  mount options=(rw,rbind) /proc/fs/ -> /proc/fs/,
  mount options=(rw,rbind) /proc/irq/ -> /proc/irq/,
  mount options=(rw,rbind) /proc/sys/ -> /proc/sys/,
  mount options=(rw,rbind) /proc/sysrq-trigger -> /proc/sysrq-trigger,
  mount options=(ro,remount,bind) -> /proc/{bus/,fs/,irq/,sys/,sysrq-trigger},
  mount options=(rw,bind) /dev/null -> /proc/{kcore,latency_stats,scsi/,timer_list},
  mount fstype=tmpfs options=(ro) -> /proc/scsi/,
}
