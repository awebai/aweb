        }
      },
      "required": [
        "id",
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "widget_button": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "const": "button"
        },
        "fallback": {
          "type": "string",
          "maxLength": 4096
        },
