            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "maxItems": 20
            }
          },
          "required": [
            "fields"
          ],
          "additionalProperties": false
        },
        "bind": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "id",
        "type",
        "props",
        "bind"
      ],
      "additionalProperties": false
    },
    "widget_list": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "const": "list"
        },
        "fallback": {
          "type": "string",
          "maxLength": 4096
        },
        "props": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "maxProperties": 32
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "maxItems": 20
            }
          },
          "required": [
            "fields"
          ],
          "additionalProperties": false
        },
        "bind": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "id",
        "type",
        "props",
        "bind"
      ],
      "additionalProperties": false
    },
    "widget_form": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "const": "form"
        },
        "fallback": {
          "type": "string",
          "maxLength": 4096
        },
        "props": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "array",
