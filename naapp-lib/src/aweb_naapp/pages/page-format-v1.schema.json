{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aweb.ai/schemas/aweb.page/1",
  "title": "aweb.page/1 page snapshot",
  "type": "object",
  "properties": {
    "page_format": {
      "const": "aweb.page/1"
    },
    "page_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "locale": {
      "type": "string",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "maxLength": 4096
    },
    "rev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "layout_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "layout": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/widget"
      },
      "maxItems": 100
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      },
      "maxItems": 32
    },
    "widget_state": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/state"
      },
      "maxProperties": 200,
      "propertyNames": {
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "maxItems": 64
    }
  },
  "required": [
    "page_format",
    "page_id",
    "locale",
    "title",
    "rev",
    "layout_version",
    "owner",
    "policy_ref",
    "layout",
    "collections",
    "widget_state",
    "actions"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "rev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "binding": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "all": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "lt",
                  "lte",
                  "gt",
                  "gte",
                  "in"
                ]
              },
              "value": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/scalar"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/scalar"
                    },
                    "maxItems": 50
                  }
                ]
              }
            },
            "required": [
              "field",
              "op",
              "value"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "asc",
                  "desc"
                ]
              }
            },
            "required": [
              "field",
              "direction"
            ],
            "additionalProperties": false
          },
          "maxItems": 8
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "cursor": {
          "type": "string",
          "maxLength": 4096
        }
      },
      "required": [
        "collection"
      ],
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "rev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "value": {
          "type": "object"
        },
        "source": {
          "type": "object",
          "properties": {
            "system": {
              "type": "string",
              "maxLength": 4096
            },
            "external_id": {
              "type": "string",
              "maxLength": 4096
            },
            "version": {
              "type": "string",
              "maxLength": 4096
            },
            "synced_at": {
              "type": "string",
              "format": "date-time"
            }
          },
          "required": [
            "system",
            "external_id",
            "version",
            "synced_at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "rev",
        "value"
      ],
      "additionalProperties": false
    },
    "collection": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "schema": {
          "type": "object"
        },
        "mode": {
          "enum": [
            "owned",
            "synced"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          },
          "maxItems": 200
        }
      },
      "required": [
        "id",
        "schema_version",
        "schema",
        "mode",
        "records"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "edit",
            "intent",
            "answer"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "input_schema": {
          "type": "object"
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "operation": {
          "type": "string",
          "maxLength": 4096
        },
        "requires_approval": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "input_schema",
        "policy_ref"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "text",
            "number",
            "date",
            "select",
            "checkbox",
            "file"
          ]
        },
        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 4096
              },
              "label": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": false
          },
          "maxItems": 100
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10485760
        },
        "accept": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]+/([a-z0-9.+-]+|\\*)(?![\\s\\S])",
            "maxLength": 128
          },
          "minItems": 1,
          "maxItems": 20
        }
      },
      "required": [
        "id",
        "kind",
        "label"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "select"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "options"
            ],
            "properties": {
              "options": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "file"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "accept",
              "max_bytes"
            ]
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "maxLength": 4096
        },
        "progress": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "busy": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scalar": {
      "oneOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "widget_text": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "const": "text"
        },
        "fallback": {
          "type": "string",
          "maxLength": 4096
        },
        "props": {
          "type": "object",
          "properties": {
            "markdown": {
              "type": "string",
              "maxLength": 1048576
            }
          },
          "required": [
            "markdown"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "widget_heading": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "const": "heading"
        },
        "fallback": {
          "type": "string",
          "maxLength": 4096
        },
        "props": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "maxLength": 4096
            },
            "level": {
              "type": "integer",
              "minimum": 1,
              "maximum": 6
            }
          },
          "required": [
            "text",
            "level"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "widget_stat": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "const": "stat"
        },
        "fallback": {
          "type": "string",
          "maxLength": 4096
        },
        "props": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 4096
            },
            "field": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "value": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 4096
                },
                {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        },
        "bind": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "id",
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "widget_status_badge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "const": "status_badge"
        },
        "fallback": {
          "type": "string",
          "maxLength": 4096
        },
        "props": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 4096
            },
            "field": {
              "type": "string",
              "maxLength": 128,
              "minLength": 1
            },
            "tone": {
              "enum": [
                "neutral",
                "info",
                "success",
                "warning",
                "danger"
              ]
            }
          },
          "required": [
            "label",
            "tone"
          ],
          "additionalProperties": false
        },
        "bind": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "id",
        "type",
        "props"
      ],
      "additionalProperties": false
    },
    "widget_table": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "const": "table"
        },
        "fallback": {
          "type": "string",
          "maxLength": 4096
        },
        "props": {
          "type": "object",
          "properties": {
            "columns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "field": {
                    "type": "string",
                    "maxLength": 128,
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "format": {
                    "enum": [
                      "text",
                      "date",
                      "number",
                      "money_minor",
                      "status",
                      "url"
                    ]
                  }
                },
                "required": [
                  "field",
                  "label",
                  "format"
                ],
                "additionalProperties": false
              },
              "maxItems": 32
            },
            "row_actions": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
              },
              "maxItems": 20
            }
          },
          "required": [
            "columns"
          ],
          "additionalProperties": false
        },
        "bind": {
          "$ref": "#/$defs/binding"
        }
      },
      "required": [
        "id",
        "type",
        "props",
        "bind"
      ],
      "additionalProperties": false
    },
    "widget_cards": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "const": "cards"
        },
        "fallback": {
          "type": "string",
          "maxLength": 4096
        },
        "props": {
          "type": "object",
          "properties": {
            "fields": {
              "type": "object",
