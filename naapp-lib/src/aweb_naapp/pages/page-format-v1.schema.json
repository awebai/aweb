          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "maxLength": 4096
            },
            "action": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
