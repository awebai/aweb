    "widget_decision_card": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
        },
        "type": {
          "const": "decision_card"
        },
        "fallback": {
          "type": "string",
          "maxLength": 4096
        },
        "props": {
          "type": "object",
          "properties": {
            "task_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "task_rev": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "collection": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "record_id": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
            },
            "record_rev": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "options": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "value": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}(?![\\s\\S])"
