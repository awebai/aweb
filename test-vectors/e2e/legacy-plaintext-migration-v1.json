{
  "version": "legacy-plaintext-migration-v1",
  "content_modes": [
    "legacy_plaintext_v1",
    "encrypted_v2",
    "server_readable_hosted"
  ],
  "legacy_display_label": "Legacy plaintext: this message was stored server-readable before E2E encryption.",
  "explicit_legacy_escape_hatch": "--legacy-plaintext",
  "downgrade_cases": [
    {
      "name": "missing_recipient_key",
      "intended_mode": "encrypted_v2",
      "result": "reject",
      "error_code": "recipient_encryption_key_missing",
      "legacy_plaintext_allowed_without_explicit_flag": false
    },
    {
      "name": "stale_recipient_key",
      "intended_mode": "encrypted_v2",
      "result": "reject",
      "error_code": "recipient_encryption_key_stale",
      "legacy_plaintext_allowed_without_explicit_flag": false
    },
    {
      "name": "old_server_no_v2_route",
      "intended_mode": "encrypted_v2",
      "result": "reject",
      "error_code": "route_e2ee_unsupported",
      "legacy_plaintext_allowed_without_explicit_flag": false
    },
    {
      "name": "explicit_legacy_plaintext",
      "intended_mode": "legacy_plaintext_v1",
      "result": "send_legacy_plaintext",
      "requires_flag": "--legacy-plaintext",
      "warning": "Sending as legacy plaintext. Subject/body may be stored and visible to the service."
    },
    {
      "name": "hosted_server_readable",
      "intended_mode": "server_readable_hosted",
      "result": "send_server_readable",
      "must_not_call_e2ee": true
    }
  ],
  "legacy_read_response": {
    "content_mode": "legacy_plaintext_v1",
    "label": "Legacy plaintext: this message was stored server-readable before E2E encryption.",
    "subject": "visible legacy subject",
    "body": "visible legacy body"
  },
  "encrypted_read_response": {
    "content_mode": "encrypted_v2",
    "message_version": 2,
    "ciphertext_hash": "sha256:example",
    "ciphertext_size": 1234,
    "key_ids": [
      "sha256:recipient"
    ]
  },
  "forbidden_encrypted_response_fields": [
    "subject",
    "body",
    "preview",
    "summary",
    "plaintext",
    "embedding"
  ]
}
