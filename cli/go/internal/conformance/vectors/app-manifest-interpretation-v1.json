{
  "schema": "aweb.app-manifest.interpretation.v1",
  "description": "Shared manifest interpretation vectors: manifest + verb + args -> exact request spec before signing.",
  "reserved_names": [
    "id",
    "whoami",
    "introspect",
    "plugin"
  ],
  "cases": [
    {
      "name": "folio_present_json_type_coercion",
      "manifest": {
        "manifest_version": 1,
        "app": {
          "id": "folio",
          "version": "1.0.0",
          "origin": "https://folio.aweb.ai"
        },
        "tools": [
          {
            "name": "present",
            "method": "POST",
            "path": "/v1/present",
            "input_schema": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string"
                },
                "ttl_seconds": {
                  "type": "integer"
                },
                "editable": {
                  "type": "boolean"
                }
              }
            },
            "params": [
              {
                "name": "slug",
                "in": "body"
              },
              {
                "name": "ttl_seconds",
                "in": "body"
              },
              {
                "name": "editable",
                "in": "body"
              }
            ],
            "body": {
              "mode": "json"
            },
            "scopes": [
              "folio:write"
            ],
            "mutation": true
          }
        ]
      },
      "verb": "present",
      "args": {
        "slug": "pitch",
        "ttl_seconds": "3600",
        "editable": "true"
      },
      "expected": {
        "method": "POST",
        "url": "https://folio.aweb.ai/v1/present",
        "path_query": "/v1/present",
        "headers": {
          "Content-Type": "application/json"
        },
        "body": "{\"editable\":true,\"slug\":\"pitch\",\"ttl_seconds\":3600}",
        "body_sha256": "d5f1d27b69f010a3b569fd4bbed7c28304c50de324cf03cd9f23c163d7403659",
        "mutation": true,
        "signed_payload": {
          "team_id": "default:example.aweb.ai",
          "timestamp": "2026-06-16T00:00:00Z",
          "canonical_payload": "{\"aud\":\"https://folio.aweb.ai\",\"body_sha256\":\"d5f1d27b69f010a3b569fd4bbed7c28304c50de324cf03cd9f23c163d7403659\",\"method\":\"POST\",\"path\":\"/v1/present\",\"team_id\":\"default:example.aweb.ai\",\"timestamp\":\"2026-06-16T00:00:00Z\",\"v\":2}",
          "signed_payload_b64url": ""
        }
      }
