#!/usr/bin/env node
"use strict";
const { execFileSync } = require("child_process");
const { NativeBinary, hostPlatform, resolveNativeBinary } = require("../platform");

let binPath;
try {
  binPath = resolveNativeBinary({ platform: hostPlatform(), binary: NativeBinary.A2A_GATEWAY });
} catch (error) {
  console.error(`Could not find the aweb-a2a-gw binary: ${error.message}`);
  console.error("Retry: npm install @awebai/aw --force");
  process.exit(1);
}

try {
  execFileSync(binPath, process.argv.slice(2), { stdio: "inherit" });
} catch (error) {
  if (Number.isInteger(error.status)) process.exit(error.status);
  throw error;
}
