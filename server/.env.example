# Docker Compose uses these to build the Postgres URLs for both aweb and awid.
POSTGRES_USER=aweb
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aweb

# Direct runtime alternative outside Compose:
# DATABASE_URL=postgresql://aweb:change-me@localhost:5432/aweb
# AWEB_DATABASE_URL=postgresql://aweb:change-me@localhost:5432/aweb
# REDIS_URL=redis://localhost:6379/0
# AWEB_REDIS_URL=redis://localhost:6379/0

# The default Docker Compose stack publishes aweb on localhost:8000 and awid on
# localhost:8010. Override AWEB_PORT and AWID_PORT here if those host ports are
# already in use.
# Both ports are published on 127.0.0.1 only. Docker's published ports bypass
# host firewalls such as ufw, so reaching them from other machines is an
# explicit choice: set AWEB_BIND_ADDRESS=0.0.0.0 (or one interface's address).
AWEB_BIND_ADDRESS=127.0.0.1
AWEB_HOST=0.0.0.0
AWEB_PORT=8000
# Public origin this aweb server advertises and accepts for federated mail/chat.
# Hosted production: https://app.aweb.ai
AWEB_PUBLIC_ORIGIN=http://localhost:8000
AWID_PORT=8010
APP_ENV=development

# Identity registry origin.
# Runtime default outside Compose: https://api.awid.ai
# Docker Compose default: http://awid:8010
# Use the public registry with member keys, or operate a separate AWID service.
AWID_REGISTRY_URL=
# Trusted caller lane shared by the aweb and AWID containers in this Compose stack.
# After copying this file to .env, append a generated value with:
# echo "AWID_SERVICE_TOKEN=$(openssl rand -hex 32)" >> .env
# AWID_SERVICE_TOKEN=
# Standalone aweb using the public registry can instead load ordinary member keys:
# AWID_MEMBER_KEYS_FILE=/etc/aweb/member-keys.json
# docker-compose.customer.yml is that shape under Compose. It takes every
# credential from a file under one host directory: aweb/member-keys.json with
# the key files it names, aweb/database-url and postgres/password:
# SECRETS_DIR=/etc/aweb-secrets

# Shared secret for verifying dashboard-issued JWTs.
AWEB_DASHBOARD_JWT_SECRET=

AWEB_LOG_LEVEL=info
AWEB_LOG_JSON=true
AWEB_RELOAD=false

# Optional runtime tuning.
AWEB_PRESENCE_TTL_SECONDS=1800
AWEB_DATABASE_USES_TRANSACTION_POOLER=false
# AWEB_DATABASE_STATEMENT_CACHE_SIZE=
# How long an app may reuse its grant answer (1-60 seconds).
# AWEB_APP_GRANT_MAX_AGE_SECONDS=60
