{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aweb.ai/drafts/agent-pages/page.schema.json",
  "title": "D1 draft page snapshot, not frozen contract",
  "type": "object",
  "properties": {
    "page_format": {
      "const": "aweb.page/1"
    },
    "page_id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "locale": {
      "type": "string",
      "maxLength": 64
    },
    "title": {
      "type": "string",
      "maxLength": 4096
    },
    "rev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "layout_version": {
      "type": "integer",
      "minimum": 1
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "policy_ref": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "layout": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/widget"
      },
      "maxItems": 100
    },
    "collections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/collection"
      },
      "maxItems": 32
    },
    "widget_state": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/state"
      },
      "maxProperties": 200
    },
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      },
      "maxItems": 64
    }
  },
  "required": [
    "page_format",
    "page_id",
    "locale",
    "title",
    "rev",
    "layout_version",
    "owner",
    "policy_ref",
    "layout",
    "collections",
    "widget_state",
    "actions"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
    },
    "rev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "binding": {
      "type": "object",
      "properties": {
        "collection": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "all": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "op": {
                "enum": [
                  "eq",
                  "ne",
                  "lt",
                  "lte",
                  "gt",
                  "gte",
                  "in"
                ]
              },
              "value": {}
            },
            "required": [
              "field",
              "op",
              "value"
            ],
            "additionalProperties": false
          },
          "maxItems": 20
        },
        "sort": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              "direction": {
                "enum": [
                  "asc",
                  "desc"
                ]
