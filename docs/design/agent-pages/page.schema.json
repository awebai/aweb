      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "rev": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "value": {
          "type": "object"
        },
        "source": {
          "type": "object",
          "properties": {
            "system": {
              "type": "string",
              "maxLength": 4096
            },
            "external_id": {
              "type": "string",
              "maxLength": 4096
            },
            "version": {
              "type": "string",
              "maxLength": 4096
            },
            "synced_at": {
