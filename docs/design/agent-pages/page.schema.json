        "label": {
          "type": "string",
          "maxLength": 4096
        },
        "input_schema": {
          "type": "object"
        },
        "policy_ref": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "target": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
        },
        "operation": {
