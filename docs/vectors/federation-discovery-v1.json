      "payload": {"authority_name": "_awid.beta.example.com", "controller_did": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd", "inherited": false, "registry_explicit": false, "registry_origin": "https://api.awid.ai", "selection": "dns", "version": "awid-v1"},
      "canonical_payload": "{\"authority_name\":\"_awid.beta.example.com\",\"controller_did\":\"did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd\",\"inherited\":false,\"registry_explicit\":false,\"registry_origin\":\"https://api.awid.ai\",\"selection\":\"dns\",\"version\":\"awid-v1\"}",
      "authority_statement_version": "aweb.federation-authority.dns.v1",
      "authority_statement_digest": "sha256:243c8fc5ecb13b973ebb278a18d802e40132c4709848b001a3ed2195820a1362"
    },
    {
      "name": "inherited_dns_authority",
      "payload": {"authority_name": "_awid.example.com", "controller_did": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd", "inherited": true, "registry_explicit": true, "registry_origin": "https://registry-b.example", "selection": "dns", "version": "awid-v1"},
      "canonical_payload": "{\"authority_name\":\"_awid.example.com\",\"controller_did\":\"did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd\",\"inherited\":true,\"registry_explicit\":true,\"registry_origin\":\"https://registry-b.example\",\"selection\":\"dns\",\"version\":\"awid-v1\"}",
      "authority_statement_version": "aweb.federation-authority.dns.v1",
      "authority_statement_digest": "sha256:ec27641fe1d8ddb197978275584d7ed38eb63f558cd84d72bae5b3fd66151767"
    },
    {
      "name": "public_default_namespace_controller",
      "payload": {"authority_name": "", "controller_did": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd", "inherited": false, "registry_explicit": false, "registry_origin": "https://api.awid.ai", "selection": "public_default", "version": "awid-v1"},
      "canonical_payload": "{\"authority_name\":\"\",\"controller_did\":\"did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd\",\"inherited\":false,\"registry_explicit\":false,\"registry_origin\":\"https://api.awid.ai\",\"selection\":\"public_default\",\"version\":\"awid-v1\"}",
      "authority_statement_version": "aweb.federation-authority.dns.v1",
      "authority_statement_digest": "sha256:2c51acd50d6e1fb4862e1477146f5a4d43732f98182a221a11367a50b0d3bfbf"
    }
  ],
  "authority_lookup_cases": [
    {
      "name": "dns_namespace_and_address_exact_match",
      "selection": "dns",
      "registry_origin": "https://registry-a.example",
      "namespace": {"domain": "alpha.example.com", "controller_did": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd"},
      "address": {"domain": "alpha.example.com", "name": "Alice", "address_id": "addr-alpha-alice", "did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "delivery_origin": "https://aweb-alpha.example"},
      "key": {"did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "status": "OK_VERIFIED"},
      "expected": {"accepted": true, "reason": null, "fallback_contacted": false}
    },
    {
      "name": "public_default_controller_comes_from_exact_namespace_row",
      "selection": "public_default",
      "registry_origin": "https://api.awid.ai",
      "namespace": {"domain": "absent.example.com", "controller_did": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd"},
      "address": {"domain": "absent.example.com", "name": "Alice", "address_id": null, "did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "delivery_origin": "https://aweb-absent.example"},
      "key": {"did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "status": "OK_VERIFIED"},
      "expected": {"accepted": true, "reason": null, "fallback_contacted": false}
    },
    {
      "name": "dns_controller_mismatch",
      "selection": "dns",
      "registry_origin": "https://registry-a.example",
      "namespace": {"domain": "alpha.example.com", "controller_did": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG"},
      "address": null,
      "key": null,
      "expected": {"accepted": false, "reason": "sender_address_did_mismatch", "fallback_contacted": false}
    },
    {
      "name": "authoritative_namespace_not_found",
      "selection": "dns",
      "registry_origin": "https://registry-a.example",
      "namespace": null,
      "address": null,
      "key": null,
      "expected": {"accepted": false, "reason": "sender_identity_not_found", "fallback_contacted": false}
    },
    {
      "name": "authoritative_address_not_found",
      "selection": "dns",
      "registry_origin": "https://registry-a.example",
      "namespace": {"domain": "alpha.example.com", "controller_did": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd"},
      "address": null,
      "key": null,
      "expected": {"accepted": false, "reason": "sender_identity_not_found", "fallback_contacted": false}
    },
    {
      "name": "verified_key_did_mismatch",
      "selection": "dns",
      "registry_origin": "https://registry-a.example",
      "namespace": {"domain": "alpha.example.com", "controller_did": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd"},
      "address": {"domain": "alpha.example.com", "name": "Alice", "address_id": "addr-alpha-alice", "did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "delivery_origin": "https://aweb-alpha.example"},
      "key": {"did_aw": "did:aw:different", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "status": "OK_VERIFIED"},
      "expected": {"accepted": false, "reason": "sender_address_did_mismatch", "fallback_contacted": false}
    },
    {
      "name": "verified_current_key_mismatch",
      "selection": "dns",
      "registry_origin": "https://registry-a.example",
      "namespace": {"domain": "alpha.example.com", "controller_did": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd"},
      "address": {"domain": "alpha.example.com", "name": "Alice", "address_id": "addr-alpha-alice", "did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "delivery_origin": "https://aweb-alpha.example"},
      "key": {"did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd", "status": "OK_VERIFIED"},
      "expected": {"accepted": false, "reason": "sender_current_key_mismatch", "fallback_contacted": false}
    },
    {
      "name": "degraded_key_never_authorizes",
      "selection": "dns",
      "registry_origin": "https://registry-a.example",
      "namespace": {"domain": "alpha.example.com", "controller_did": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd"},
      "address": {"domain": "alpha.example.com", "name": "Alice", "address_id": "addr-alpha-alice", "did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "delivery_origin": "https://aweb-alpha.example"},
      "key": {"did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "status": "OK_DEGRADED"},
      "expected": {"accepted": false, "reason": "sender_identity_unverifiable", "fallback_contacted": false, "full_log_required": true}
