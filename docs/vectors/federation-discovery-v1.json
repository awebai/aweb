    {
      "name": "selected_registry_transport_failure_never_falls_back",
      "selection": "dns",
      "registry_origin": "https://registry-a.example",
      "namespace": "transport_failure",
      "address": null,
      "key": null,
      "expected": {"accepted": false, "reason": "sender_registry_unavailable", "fallback_contacted": false}
    },
    {
      "name": "copied_log_does_not_authorize_registry_migration",
      "selection": "dns",
      "registry_origin": "https://registry-b.example",
      "namespace": {"domain": "alpha.example.com", "controller_did": "did:key:z6MkehRgf7yJbgaGfYsdoAsKdBPE3dj2CYhowQdcjqSJgvVd"},
      "address": {"domain": "alpha.example.com", "name": "Alice", "address_id": "copied", "did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "delivery_origin": "https://aweb-attacker.example"},
      "key": {"did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2", "current_did_key": "did:key:z6Mkgxj2R3HLtQRpPnvfvpuKEceSqf3tZHBjdmZ3fFz3JHGG", "status": "OK_VERIFIED", "extends_checkpoint": false},
      "expected": {"accepted": false, "reason": "sender_did_log_split_view", "fallback_contacted": false}
