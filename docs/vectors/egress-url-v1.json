{
  "name": "egress-url-v1",
  "status": "frozen by its reviewed landing (aweb-acgh.18.2, S1); derived from secrets.md section 7.2 and the section 16 scope rows; a change needs a new version",
  "scheme": {
    "url": "https only (scheme compared case-insensitively, written lowercase); no userinfo, no fragment, no backslash, no whitespace or control character anywhere; only the host may hold non-ASCII characters",
    "host": "IDNA2008 with UTS46 mapping (non-transitional, STD3 rules) to lowercase A-labels; empty labels and a trailing dot are refused; a host whose last label is numeric or 0x-hex is refused unless it is a dotted-quad IPv4 address without leading zeros; an IPv6 literal is bracketed, has no zone and is written compressed and lowercase",
    "port": "decimal 1-65535 without leading zeros; 443 is the default and is omitted from the canonical URL",
    "path": "empty becomes '/'; raw characters are unreserved, sub-delims, ':', '@', '/' and '%'; each percent-encoding is two hex digits; encodings of unreserved characters are decoded and the hex of every other encoding is uppercased; %2F, %5C, %00 to %1F and %7F are refused; after decoding, an empty segment ('//') and a '.' or '..' segment are refused; one trailing '/' is kept",
    "query": "an empty query after '?' is dropped; pairs are separated by '&' and kept in order; a pair is key or key=value; an empty pair, a raw '+', and a raw '=' inside a value are refused; raw characters are unreserved, sub-delims other than '&', '+' and '=', ':', '@', '/', '?' and '%'; percent-encodings follow the path rules except that only %00 to %1F and %7F are refused; keys and values must decode to UTF-8",
    "destination": "{host, port (default 443), path, methods, query_rules, header_allow, network ('public' default, or 'internal' with cidr)}",
    "destination_host": "a canonical host; or '*.' plus a canonical host, where '*' is exactly one leftmost label, never matches the bare parent and never matches more than one label, and the parent must not be a public suffix in the pinned Public Suffix List, ICANN and private sections alike; or an IP literal, only with network 'internal'",
    "destination_path": "a canonical path whose segments are literal, '{name}' (one non-empty segment, captured), or '**' as the last segment (that position and everything below it, including nothing); names match ^[a-z_][a-z0-9_]{0,63}$ and are unique",
    "methods": "a non-empty subset of GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS, matched case-sensitively; CONNECT, TRACE and any other method are always refused",
    "query_rules": "maps a decoded key to {presence: required|optional|forbidden, repeatable: bool (default false)}; a key without a rule is allowed once; a repeated key is refused unless its rule is repeatable",
    "internal_destinations": "a deploy setting, disabled (default) or allowed; under disabled every network 'internal' destination and every IP-literal destination is refused, at definition and at dispatch",
    "refusal": "every refusal has a code from the hook catalog's refusal_code enum and a rule naming the clause that fired"
  },
