            "records": [
              "b-99"
            ],
            "fields": [
              "status"
            ]
          }
        },
        "actions": []
      },
      "expect": {
        "refused": "action_denied"
      }
    },
    {
      "name": "action-creator-lacks",
      "creator": {
        "reads": {
          "bookings": {
            "records": [
              "b-17",
              "b-18"
            ],
            "fields": [
              "arrival",
              "departure",
              "status",
              "guest_note"
            ]
          }
        },
        "actions": [
          "mark-cleaned",
          "request-cleaner"
        ]
      },
      "link": {
        "projection": {
          "bookings": {
            "records": [
              "b-17"
            ],
            "fields": [
              "status"
            ]
          }
        },
