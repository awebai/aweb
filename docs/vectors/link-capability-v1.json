            "records": [
              "b-17"
            ],
            "fields": [
              "status"
            ]
          }
        },
        "actions": [],
        "expires_in_seconds": 2592001
      },
      "expect": {
        "refused": "schema_invalid"
      }
    }
  ],
  "use_sequence": [
    {
      "step": "exchange",
      "secret": "wrong",
      "result": {
        "status": 404,
        "code": "link_unavailable"
      }
    },
    {
      "step": "exchange",
      "secret": "right",
      "result": {
        "status": 200,
        "session": "s1"
      }
    },
    {
      "step": "read",
      "session": "s1",
      "fields": [
        "arrival",
        "status"
      ],
      "result": {
        "status": 200
      }
    },
    {
      "step": "read",
      "session": "s1",
      "fields": [
        "guest_note"
      ],
      "result": {
        "status": 403,
        "code": "action_denied"
      },
      "note": "outside the projection, although the creator could read it"
    },
    {
      "step": "action",
      "session": "s1",
      "action_id": "mark-cleaned",
      "input": {
        "record_id": "b-18"
      },
      "nonce": "n1",
      "idempotency_key": "k1",
      "result": {
        "status": 403,
        "code": "action_denied"
      },
      "note": "violates the link's constraint"
    },
    {
      "step": "action",
      "session": "s1",
      "action_id": "mark-cleaned",
      "input": {
        "record_id": "b-17"
      },
      "nonce": "n2",
      "idempotency_key": "k2",
      "result": {
        "status": 200,
        "receipt": "r2"
      }
    },
    {
      "step": "action",
      "session": "s1",
      "action_id": "mark-cleaned",
      "input": {
        "record_id": "b-17"
      },
      "nonce": "n2",
      "idempotency_key": "k2",
      "result": {
        "status": 409,
        "code": "idempotency_conflict"
      },
      "note": "replayed nonce"
    },
    {
      "step": "action",
      "session": "s1",
      "action_id": "mark-cleaned",
      "input": {
        "record_id": "b-17"
      },
      "nonce": "n3",
      "idempotency_key": "k2",
      "result": {
        "status": 200,
        "same_receipt_as": 5
      },
      "note": "a retry after a lost response: fresh nonce, same idempotency key, stored receipt"
    },
    {
      "step": "action",
      "session": "s1",
      "action_id": "mark-cleaned",
      "input": {
        "record_id": "b-17"
      },
      "nonce": "n4",
      "idempotency_key": "k4",
      "origin": "https://evil.example",
      "result": {
        "status": 403,
        "code": "action_denied"
      }
    },
    {
      "step": "action",
      "session": "s1",
      "action_id": "mark-cleaned",
      "input": {
        "record_id": "b-17"
      },
      "nonce": "n5",
      "idempotency_key": "k5",
      "csrf": "missing",
      "result": {
        "status": 403,
        "code": "action_denied"
      }
    },
    {
      "step": "action",
      "session": "s1",
      "action_id": "mark-cleaned",
      "input": {
        "record_id": "b-17"
      },
      "nonce": "n6",
      "idempotency_key": "k6",
      "csrf": "another_session",
      "result": {
        "status": 403,
        "code": "action_denied"
      }
    },
    {
      "step": "creator_loses_field",
      "field": "status"
    },
    {
      "step": "read",
      "session": "s1",
      "fields": [
        "status"
      ],
      "result": {
        "status": 403,
        "code": "action_denied"
      },
      "note": "the link narrows with its creator's authority"
    },
    {
      "step": "stream_open",
      "session": "s1",
      "result": {
        "status": 200
      }
    },
    {
      "step": "creator_loses_record",
      "record_id": "b-17"
    },
    {
      "step": "stream_check",
      "after_seconds": 15,
      "result": {
        "closed": true
      },
      "note": "the stream re-runs the full lifecycle check, creator authority included, within 15 s"
    },
    {
      "step": "revoke",
      "result": {
        "status": 200
      }
    },
    {
      "step": "read",
      "session": "s1",
      "fields": [
        "arrival"
      ],
      "result": {
        "status": 410,
        "code": "link_unavailable"
      }
    },
    {
      "step": "exchange",
      "secret": "right",
      "result": {
        "status": 404,
        "code": "link_unavailable"
      },
      "note": "no new session for a revoked link"
    }
  ],
  "expiry_sequence": [
    {
      "step": "mint",
      "expires_at": "2026-10-20T12:10:00Z",
      "result": {
        "status": 201
      }
    },
    {
      "step": "exchange",
      "at": "2026-10-20T12:00:00Z",
      "secret": "right",
      "result": {
        "status": 200,
        "session_expires_at": "2026-10-20T12:10:00Z"
      },
      "note": "a session lasts at most 15 minutes and never past the link's expiry"
    },
    {
      "step": "read",
      "at": "2026-10-20T12:09:59Z",
      "fields": [
        "arrival"
      ],
      "result": {
        "status": 200
      }
    },
    {
      "step": "read",
      "at": "2026-10-20T12:10:00Z",
      "fields": [
        "arrival"
      ],
      "result": {
        "status": 410,
        "code": "link_unavailable"
      },
      "note": "the link has expired; its session goes with it"
    },
    {
      "step": "exchange",
      "at": "2026-10-20T12:10:01Z",
      "secret": "right",
      "result": {
        "status": 404,
        "code": "link_unavailable"
      }
    }
  ],
  "replay_cases": [
    {
      "name": "receipt-after-one-use",
      "one_use": true,
      "steps": [
        {
          "action": "k1",
          "nonce": "n1",
          "result": {
            "status": 200,
            "receipt": "r1"
          }
        },
        {
          "action": "k1",
          "nonce": "n2",
          "same_body": true,
          "result": {
            "status": 200,
            "receipt": "r1"
          }
        },
        {
          "action": "k2",
          "nonce": "n3",
          "result": {
            "status": 410,
            "code": "link_unavailable"
          }
        }
      ],
      "note": "the stored receipt comes back after the link is used up; no second operation is admitted"
    },
    {
      "name": "receipt-after-revocation-with-live-session",
      "steps": [
        {
          "action": "k1",
          "nonce": "n1",
          "result": {
            "status": 200,
            "receipt": "r1"
          }
        },
        {
          "revoke": true
        },
        {
          "action": "k1",
          "nonce": "n2",
          "same_body": true,
          "result": {
            "status": 200,
            "receipt": "r1"
          }
        },
        {
          "action": "k2",
          "nonce": "n3",
          "result": {
            "status": 410,
            "code": "link_unavailable"
          }
        }
      ]
    },
    {
      "name": "no-receipt-once-the-session-expired",
      "note": "a session never outlives its link, so after the link's expiry there is no live session to retry with",
      "steps": [
        {
          "action": "k1",
          "nonce": "n1",
          "result": {
            "status": 200,
            "receipt": "r1"
          }
        },
        {
          "session_expires": true
        },
        {
          "action": "k1",
          "nonce": "n2",
          "same_body": true,
          "result": {
            "status": 410,
            "code": "link_unavailable"
          }
        }
      ]
    },
    {
      "name": "receipt-key-with-different-body",
      "steps": [
        {
          "action": "k1",
          "nonce": "n1",
          "result": {
            "status": 200,
            "receipt": "r1"
          }
        },
        {
          "action": "k1",
          "nonce": "n2",
          "same_body": false,
          "result": {
            "status": 409,
            "code": "idempotency_conflict"
          }
        }
      ]
    },
    {
      "name": "refused-action-keeps-its-nonce",
      "steps": [
        {
          "action": "k1",
          "nonce": "n1",
          "violates_constraint": true,
          "result": {
            "status": 403,
            "code": "action_denied"
          }
        },
        {
          "same_signed_request_again": true,
          "result": {
            "status": 409,
            "code": "idempotency_conflict"
          }
        }
      ],
      "note": "the nonce is recorded in its own write, before the action runs"
    },
    {
      "name": "concurrent-duplicate-nonce",
      "steps": [
        {
          "concurrent": [
            "request_a_nonce_n1",
            "request_b_nonce_n1"
          ],
          "result": {
            "one": {
              "status": 200
            },
            "other": {
              "status": 409,
              "code": "idempotency_conflict"
            }
          }
        }
      ]
    }
  ],
  "asset_sequence": [
    {
      "step": "read",
      "fields": [
        "arrival"
      ],
      "assets": [
        "ast-1"
      ],
      "result": {
        "status": 200,
        "asset_grants": [
          "g1"
        ]
      },
      "note": "a signed read returns a grant per projected asset it shows"
    },
    {
      "step": "asset_get",
      "grant": "g1",
      "range": "bytes=0-65535",
      "result": {
        "status": 206
      }
    },
    {
      "step": "asset_get",
      "grant": "g1",
      "range": "bytes=65536-131071",
      "result": {
        "status": 206
      },
      "note": "a grant serves any number of range requests within its window"
    },
    {
      "step": "asset_get",
      "grant": "g1",
      "asset_id": "ast-2",
      "result": {
        "status": 403,
        "code": "action_denied"
      },
      "note": "a grant names one asset"
    },
    {
      "step": "revoke",
      "result": {
        "status": 200
      }
    },
    {
      "step": "asset_get",
      "grant": "g1",
      "range": "bytes=131072-196607",
      "result": {
        "status": 410,
        "code": "link_unavailable"
      },
      "note": "revocation stops a video at its next range request"
    }
  ],
  "grant_expiry": [
    {
      "step": "read",
      "at": "2026-10-20T12:00:00Z",
      "assets": [
        "ast-1"
      ],
      "result": {
        "status": 200,
        "grant_expires_at": "2026-10-20T12:05:00Z"
      }
    },
    {
      "step": "asset_get",
      "at": "2026-10-20T12:05:00Z",
      "grant": "g1",
      "result": {
        "status": 410,
        "code": "link_unavailable"
      },
      "note": "a grant lasts at most 5 minutes and never past its session"
    }
  ],
  "race": [
    {
      "name": "revoke-commits-first",
      "order": [
        "revoke_commit",
        "action_admit"
      ],
      "result": {
        "action": {
          "status": 410,
          "code": "link_unavailable"
        }
      }
    },
    {
      "name": "action-commits-first",
      "order": [
        "action_admit",
        "revoke_commit"
      ],
      "result": {
        "action": {
          "status": 200,
          "receipt_kept": true
        },
        "later_read": {
          "status": 410,
          "code": "link_unavailable"
        }
      }
    },
    {
      "name": "one-use-concurrent-submits",
      "one_use": true,
      "order": [
        "submit_a_admit",
        "submit_b_waits_on_lock",
        "submit_b_checks"
      ],
      "result": {
        "a": {
          "status": 200
        },
        "b": {
          "status": 410,
          "code": "link_unavailable"
        }
      }
    },
    {
      "name": "one-use-reads-consume-nothing",
      "one_use": true,
      "order": [
        "read",
        "read",
        "preview",
        "failed_signature",
        "submit_admit"
      ],
      "result": {
        "submit": {
          "status": 200
        },
        "used_at_set_by": "submit_admit"
      }
    },
    {
      "name": "stream-revoked-mid-stream",
      "order": [
        "stream_open",
        "revoke_commit",
        "stream_check_within_15s"
      ],
      "result": {
        "stream": {
          "closed": true
        }
      }
    }
  ],
  "lockout": [
    {
      "name": "wrong-secrets-do-not-lock-out-holder",
      "steps": [
        {
          "exchange": "wrong",
          "from": "attacker",
          "times": 50
        },
        {
          "exchange": "right",
          "from": "holder"
        }
      ],
      "result": {
        "attacker": {
          "last": {
            "status": 429,
            "code": "safety_rate_limited"
          }
        },
        "holder": {
          "status": 200
        }
      },
      "note": "failures count against the client address; only successful exchanges count per link"
    }
  ]
}
