    "proto_path": "specification/a2a.proto",
    "spec_path": "docs/specification.md",
    "checked_at": "2026-06-07",
    "normative_notes": [
      "AgentCard endpoint fields live under supportedInterfaces[].",
      "AgentCard version is the card/service contract version; supportedInterfaces[].protocolVersion is the A2A protocol version.",
      "SendMessageConfiguration.returnImmediately true returns immediately.",
      "SendMessageConfiguration.returnImmediately false or absent waits until terminal or interrupted task state.",
      "Task states are protocol enum strings such as TASK_STATE_WORKING and TASK_STATE_FAILED.",
      "Gateway ingress fixtures are strict A2A v1.0; pre-1.0 slash method aliases are not accepted unless a later compatibility mode is explicitly specified."
    ]
  },
  "card_digest_contract": {
    "algorithm": "sha256",
    "encoding": "sha256:<lowercase-hex>",
    "canonicalization": "A2A v1.0 card-signature canonical bytes over the materialized AgentCard object after omitting signatures: A2A field/default processing, then JCS/awid.CanonicalJSONValue-compatible canonical JSON.",
    "excluded_fields": ["signatures"]
  },
