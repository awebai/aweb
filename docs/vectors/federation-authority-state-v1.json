  "cohort_cases": [
    {"name": "cohort_key_is_canonical_address_not_did", "input": {"address": "alpha.example.com/Alice", "did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2"}, "expected": {"key": "alpha.example.com/Alice", "key_includes_did": false}},
    {"name": "same_did_two_addresses_have_separate_cohorts", "input": {"addresses": ["alpha.example.com/Alice", "beta.example.com/Alice"], "did_aw": "did:aw:2CiZ88hVF4JuQim8nnSuyeiV2HF2"}, "expected": {"cohort_count": 2, "cross_hit": false}},
    {"name": "checkpoint_advance_invalidates_every_older_did_cohort", "input": {"old_checkpoint_revision": 1, "new_checkpoint_revision": 2, "cohort_generations": [4, 9]}, "expected": {"expired_count": 2, "generation_invalidated_count": 2, "same_transaction": true}},
    {"name": "new_authority_tuple_replaces_whole_generation", "input": {"old_generation": 4, "new_generation": 5, "changed_fields": ["controller_did", "registry_origin", "address_id", "authoritative_delivery_origin"]}, "expected": {"merge_fields": false, "generation": 5}},
    {"name": "fast_path_requires_postgresql_row_and_exact_tuple", "input": {"unexpired": true, "process_local_copy": true, "shared_row_read": false}, "expected": {"authorized": false, "reason": "federation_authority_coordination_unavailable"}},
    {"name": "expiry_starts_at_complete_authoritative_read_using_database_time", "input": {"request_started_at": "2026-08-01T12:00:00Z", "authoritative_read_completed_at": "2026-08-01T12:00:04Z", "process_clock": "2026-08-01T13:00:00Z"}, "expected": {"expiry_base": "postgresql_clock_timestamp_at_complete_read", "expires_at": "2026-08-01T12:01:04Z"}},
    {"name": "expiry_requires_full_authoritative_reread", "input": {"cohort_age_seconds": 60, "general_cache_live": true}, "expected": {"reuse": false, "reread": ["dns", "namespace", "address", "key_or_log", "origin"]}},
    {"name": "fresh_source_change_invalidates_peer_cohorts", "input": {"expired": true, "source_changed": true}, "expected": {"old_claim_authorized": false, "peer_generations_invalidated": true}},
    {"name": "source_suppression_can_renew_old_valid_state_without_sla_claim", "input": {"expired": true, "source_changed_but_suppressed": true, "served_state_cryptographically_valid": true}, "expected": {"reread_performed": true, "old_state_may_renew": true, "freshness_sla": false}}
  ],
  "work_fence_cases": [
    {"name": "lease_uses_database_time", "input": {"process_clock_skew_seconds": 3600}, "expected": {"expiry_clock": "postgresql_clock_timestamp", "process_clock_authoritative": false}},
    {"name": "external_work_holds_no_pool_connection", "input": {"stage": "dns_http_crypto"}, "expected": {"open_transaction": false, "checked_out_connection": false}},
    {"name": "takeover_increments_persistent_fence", "input": {"expired_owner": "owner-1", "old_fence": 7, "new_owner": "owner-2"}, "expected": {"new_fence": 8, "counter_deleted": false}},
    {"name": "expired_owner_cannot_publish_after_takeover", "input": {"publisher_owner": "owner-1", "publisher_fence": 7, "live_owner": "owner-2", "live_fence": 8}, "expected": {"publish": false, "reason": "federation_authority_cas_conflict"}},
    {"name": "phase_a_locks_every_consumed_fence", "input": {"consumed_scopes": ["discovery:example.com", "origin:https://registry.example", "did:did:aw:fixture"]}, "expected": {"sorted_scope_locking": true, "exact_owner_fence_unexpired_required": true}},
    {"name": "permit_count_ignores_expired_leases", "input": {"active": 3, "expired": 2, "limit": 4}, "expected": {"counted": 3, "permit_granted": true}},
    {"name": "bigint_fence_overflow_fails_closed", "input": {"fence": 9223372036854775807}, "expected": {"publish": false, "reason": "federation_authority_coordination_unavailable"}},
    {"name": "coordination_outage_has_no_local_or_redis_fallback", "input": {"postgresql_available": false, "redis_available": true, "process_cache_available": true}, "expected": {"authorized": false, "reason": "federation_authority_coordination_unavailable"}}
  ],
  "evidence_reuse_cases": [
    {"name": "wrong_claim_then_correct_claim_uses_same_evidence_independent_comparison", "input": {"authority_generation": 4, "claims": ["wrong-did", "correct-did"]}, "expected": {"external_fetches": 1, "results": ["sender_address_did_mismatch", "accepted"], "mismatch_cached": false}},
    {"name": "concurrent_wrong_and_correct_claim_cannot_poison", "input": {"authority_generation": 4, "concurrent_claims": ["wrong-key", "correct-key"]}, "expected": {"shared_evidence": true, "wrong_result": "sender_current_key_mismatch", "correct_result": "accepted"}},
    {"name": "mismatch_is_never_keyed_by_address_domain_or_did", "input": {"candidate_keys": ["address", "domain", "did_aw"]}, "expected": {"allowed_keys": [], "default_memoization": "none"}},
    {"name": "authoritative_not_found_scope_is_complete", "input": {"reuse_seconds": 15}, "expected": {"key_fields": ["authority_statement_digest", "authority_generation", "registry_origin", "canonical_address", "did_aw_where_applicable"]}},
    {"name": "malformed_evidence_scope_includes_response_digest", "input": {"reuse": true}, "expected": {"key_fields": ["complete_source_scope", "response_digest"]}},
    {"name": "dns_transport_failure_is_retryable_and_short_lived", "input": {"reuse_seconds": 5}, "expected": {"retryable": true, "max_seconds": 5}},
    {"name": "controlled_bypass_is_one_per_message_and_shared", "input": {"attempted_bypasses": 2}, "expected": {"performed_bypasses": 1, "through_singleflight": true}},
    {"name": "source_generation_replacement_discards_old_comparisons", "input": {"old_generation": 4, "new_generation": 5}, "expected": {"old_mismatch_reused": false, "new_tuple_replaces_whole": true}}
  ],
