      "answer": {
        "required": {
          "team_id": "string",
          "signing_key_present": "bool",
          "identity_present": "bool",
          "identity_registered": "bool",
          "registry_status": "string",
          "did": "string",
          "stable_id": "string",
          "address": "string",
          "alias": "string",
          "certificate_present": "bool",
          "certificate_id": "string",
          "workspace_bound": "bool",
          "workspace_id": "string",
          "service": "string",
          "partial_init": "object",
          "pending_hosted_accept": "bool",
          "mint_complete": "bool"
        },
        "optional": {}
      },
      "notes": "registry_status: registered|pending|unknown|not_applicable; partial_init: {present bool, stage absent|identity_prepared|response_received}"
    },
    {
      "id": "id_team_list",
