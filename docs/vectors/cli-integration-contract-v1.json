{
  "contract": "aw-framework",
  "version": 1,
  "status": "draft",
  "owner": "docs/cli-integration-contract.md",
  "version_probe": {
    "argv": [
      "aw",
      "version",
      "--json"
    ],
    "identity": "none",
    "network": false,
    "answer": {
      "required": {
        "version": "string",
        "commit": "string",
        "commit_repo": "string",
        "built": "string",
        "integration_contract": "int"
      }
    },
    "acceptance": "exact; checked at start on the exact aw executable before any effect; refuse when missing, malformed or not the accepted number"
  },
  "rules": {
    "invocation": "argument array, never a shell; --json on every listed command; secrets on stdin",
    "selector": "--identity-home ABSOLUTE_PATH before the subcommand; then AWEB_IDENTITY_HOME; then ./.aw; an unloadable selection fails without fallback",
    "stdout": "exactly one JSON document on success; key order, whitespace and the name key are not promised; unlisted keys are ignored",
    "stderr": "not part of the contract",
    "exits": {
      "0": "success",
      "1": "failure",
      "2": "usage error or refusal before any effect"
    },
    "error_envelope": {
      "required": {
        "error": {
          "code": "string",
          "message": "string"
        }
      },
      "optional": {
        "error.http_status": "int",
        "error.detail": "string",
        "error.reason": "string",
        "error.classification": "string",
        "invite": "object",
        "release": "object"
      },
      "generic_codes": [
        "error",
        "http_error",
        "alias_conflict",
        "outcome_unknown"
      ],
      "codes_list": "cli-integration-codes-v1.json, edition pinned by digest when version 1 is released"
    },
    "distinguish": [
      "aw could not start",
      "the caller's timeout",
      "empty, truncated or invalid stdout",
      "the error envelope",
      "a result printed with a nonzero exit, where listed"
    ]
  },
  "commands": [
