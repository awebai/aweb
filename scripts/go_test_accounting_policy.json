{
  "schema_version": 1,
  "module": "github.com/awebai/aw",
  "release_platform": "linux-amd64",
  "release_preconditions": {
    "system": "Linux",
    "machines": ["x86_64", "amd64"],
    "effective_uid_must_not_be": 0,
    "tools": ["tmux", "sh", "python3"]
  },
  "inventory_counts": {
    "runtime_skip_sites": 30,
