        {"package": "github.com/awebai/aw/cmd/aw", "name": "TestPluginExternalDispatchUsesTrustedDirOnlyAndEnvContract"},
        {"package": "github.com/awebai/aw/cmd/aw", "name": "TestExternalPluginEnvAllowlistExcludesDotenvSecrets"},
        {"package": "github.com/awebai/aw/cmd/aw", "name": "TestPluginManagementInstallListRemoveAndRejectBuiltins"},
        {"package": "github.com/awebai/aw/cmd/aw", "name": "TestExternalPluginTraceReportsThatHTTPTracingIsUnavailable"},
        {"package": "github.com/awebai/aw/cmd/aw", "name": "TestPluginBuiltInCommandWinsOverTrustedPlugin"},
        {"package": "github.com/awebai/aw/cmd/aw", "name": "TestLaunchAgentWindowTargetsCollidingSessionName"},
        {"package": "github.com/awebai/aw/cmd/aw", "name": "TestTeamUpInsideTmuxLaunchesIntoReachableCallerSession"},
        {"package": "github.com/awebai/aw/run", "name": "TestRealCommandRunnerStreamsPartialStderrBeforeExit"},
        {"package": "github.com/awebai/aw/run", "name": "TestRealCommandRunnerStreamsStderrBeforeExitFailure"},
        {"package": "github.com/awebai/aw/run", "name": "TestRealCommandRunnerStreamsPartialStdoutBeforeExit"},
        {"package": "github.com/awebai/aw/run", "name": "TestRealCommandRunnerAcceptsProviderInput"},
        {"package": "github.com/awebai/aw/run", "name": "TestRealCommandRunnerUsesNullStdinWhenProviderInputIsUnused"},
        {"package": "github.com/awebai/aw/run", "name": "TestRealCommandRunnerWritesInitialPromptToStdin"},
        {"package": "github.com/awebai/aw/run", "name": "TestRealCommandRunnerPTYProvidesTTYAndAcceptsInput"}
      ]
    },
    "e2e": {
      "command": ["go", "test", "-json", "-tags", "e2e", "./e2e", "-count=1"],
      "packages": ["github.com/awebai/aw/e2e"],
