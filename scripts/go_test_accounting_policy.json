    "separately_exercised_runtime_skip_sites": 2,
    "build_constraints": 12,
    "default_packages": 17,
    "default_required_tests": 24,
    "e2e_packages": 1,
    "e2e_required_tests": 8
  },
  "suites": {
    "default": {
      "command": ["go", "test", "-json", "./...", "-count=1"],
      "packages": [
        "github.com/awebai/aw",
        "github.com/awebai/aw/a2a",
        "github.com/awebai/aw/a2agw",
        "github.com/awebai/aw/awconfig",
