      "required_tests": [
        {"package": "github.com/awebai/aw/awconfig", "name": "TestListTeamInvitesByOperationRejectsSymlinkedGrant"},
        {"package": "github.com/awebai/aw/awid", "name": "TestLoadPinStoreRejectsUnreadableFile"},
        {"package": "github.com/awebai/aw/awid", "name": "TestDidLogSeqOutsideSafeIntegerRangeIsRefused"},
        {"package": "github.com/awebai/aw/chat", "name": "TestConcurrentProcessesKeepEveryDeliveryMark"},
        {"package": "github.com/awebai/aw/chat", "name": "TestConcurrentProcessesWithOverlappingIDs"},
